{
  "name": "tiemora",
  "version": "0.2.0",
  "description": "Open-source catalog-first storefront, booking, ordering and inventory platform for small businesses. Vietnam-first workflows, Cloudflare-native infrastructure.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/siska-tech/tiemora.git"
  },
  "homepage": "https://github.com/siska-tech/tiemora#readme",
  "bugs": "https://github.com/siska-tech/tiemora/issues",
  "keywords": ["storefront", "booking", "orders", "rental", "inventory", "cloudflare-workers", "d1", "small-business", "vietnam"],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && wrangler dev",
    "build": "node scripts/build.mjs",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "generate:seed": "node scripts/generate-seed.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "login": "wrangler login",
    "db:create": "wrangler d1 create tiemora",
    "db:migrate:local": "wrangler d1 migrations apply tiemora --local",
    "db:migrate": "wrangler d1 migrations apply tiemora --remote",
    "db:seed:local": "wrangler d1 execute tiemora --local --file=seed/demo.sql",
    "db:seed": "wrangler d1 execute tiemora --remote --file=seed/demo.sql",
    "db:seed:sale:local": "wrangler d1 execute tiemora --local --file=seed/sale-demo.sql",
    "db:seed:sale": "wrangler d1 execute tiemora --remote --file=seed/sale-demo.sql",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "setup:vapid": "node scripts/setup-secrets.mjs vapid",
    "setup:turnstile": "node scripts/setup-secrets.mjs turnstile",
    "setup:status": "node scripts/setup-secrets.mjs status",
    "turnstile:list": "wrangler turnstile widget list"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "30.1.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.2",
    "wrangler": "4.135.0",
    "yaml": "2.9.1"
  }
}
