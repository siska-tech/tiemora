{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable", "webworker"],
    "types": ["node", "@cloudflare/workers-types"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["core/**/*.mjs", "worker/**/*.mjs", "scripts/**/*.mjs"]
}
